{
    "data": {
        "feature_path": "params/features.npy",
        "label_path": "params/labels.npy",
        "test_size": 0.2,
        "random_state": 42,
        "seq_length": 601
    },
    "model": {
        "num_channels": [32, 32, 64, 64, 64, 128, 128],
        "kernel_size": 7,
        "dropout": 0.2
    },
    "loss": {
        "type": "berhu",
        "delta": 1.0,
        "alpha": 1.5
    },
    "training": {
        "num_epochs": 300,
        "batch_size": 32,
        "patience": 50,
        "log_target_min": -9.0,
        "log_target_max": -0.3
    },
    "optimizer": {
        "lr": 1e-3,
        "weight_decay": 1e-4
    },
    "scheduler": {
        "warmup_start_factor": 0.01,
        "warmup_total_iters": 10,
        "cosine_T_0": 50,
        "cosine_T_mult": 2,
        "cosine_eta_min": 1e-6,
        "milestone": 10
    },
    "sampler": {
        "bin_edges": [-10, -8, -6, -5, -4, -3, -2, -1, 0]
    },
    "uncertainty_encoder": {
        "d_model": 32,
        "num_heads": 4,
        "dropout": 0.1
    },
    "debris_phase": {
        "threshold_a_years": 2.0,
        "threshold_b_years": 7.0
    },
    "fds": {
        "enabled": true,
        "bucket_num": 100,
        "ks": 5,
        "sigma": 2,
        "momentum": 0.9,
        "start_update": 30,
        "start_smooth": 40,
        "residual_alpha": 0.2
    },
    "lds": {
        "num_bins": 100,
        "kernel": "gaussian",
        "ks": 5,
        "sigma": 2
    },
    "data_collection": {
        "tle_filter": {
            "enabled": true,
            "pc_low": 1e-6,
            "pc_high": 1e-4
        }
    }
}
