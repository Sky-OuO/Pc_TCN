{
    "feature_generation": {
        "delta_t_minutes": 10,
        "time_step_seconds": 10,
        "near_tca_minutes": 1,
        "near_tca_time_step_seconds": 2,
        "min_distance_filter": {
            "enabled": true,
            "threshold_km": 5.0,
            "pc_min": 1e-3
        }
    },
    "data": {
        "feature_path": "params/features.npy",
        "label_path": "params/labels.npy",
        "test_size": 0.2,
        "random_state": 42,
        "seq_length": 85
    },
    "model": {
        "num_channels": [32, 64, 128],
        "kernel_size": 3,
        "dropout": 0.4
    },
    "xgboost": {
        "n_estimators": 300,
        "max_depth": 4,
        "learning_rate": 0.05,
        "subsample": 0.8,
        "colsample_bytree": 0.8
    },
    "xgb_leaf_embed": {
        "max_leaves": 64,
        "embed_dim": 8,
        "out_dim": 64
    },
    "loss": {
        "high_pc_threshold": -4.0,
        "alpha_high": 2.0
    },
    "training": {
        "num_epochs": 200,
        "batch_size": 32,
        "patience": 20,
        "log_target_min": -9.0,
        "log_target_max": -0.3
    },
    "optimizer": {
        "lr": 1e-3,
        "weight_decay": 1e-3
    },
    "scheduler": {
        "mode": "min",
        "factor": 0.5,
        "patience": 10
    },
    "regression_head": {
        "dims": [64, 32]
    },
    "data_collection": {
        "tle_filter": {
            "enabled": true,
            "pc_low": 1e-8,
            "pc_high": 5e-3
        }
    }
}
