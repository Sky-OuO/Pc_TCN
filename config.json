{
    "feature_generation": {
        "delta_t_minutes": 30,
        "time_step_seconds": 10
    },
    "data": {
        "feature_path": "params/features.npy",
        "label_path": "params/labels.npy",
        "test_size": 0.2,
        "random_state": 42,
        "seq_length": 121
    },
    "model": {
        "num_channels": [64, 128, 128, 256, 256],
        "kernel_size": 5,
        "dropout": 0.3
    },
    "loss": {
        "high_pc_threshold": -3.0,
        "alpha_high": 3.0
    },
    "training": {
        "num_epochs": 200,
        "batch_size": 32,
        "patience": 20,
        "log_target_min": -9.0,
        "log_target_max": -0.3
    },
    "optimizer": {
        "lr": 1e-4,
        "weight_decay": 1e-4
    },
    "scheduler": {
        "cosine_T_max": 290,
        "cosine_eta_min": 1e-6
    },
    "uncertainty_encoder": {
        "d_model": 32,
        "num_heads": 4,
        "dropout": 0.1,
        "num_layers": 2
    },
    "debris_phase": {
        "threshold_a_years": 2.0,
        "threshold_b_years": 7.0
    },
    "fds": {
        "enabled": true,
        "bucket_num": 60,
        "ks": 3,
        "sigma": 0.5,
        "momentum": 0.9,
        "start_update": 50,
        "start_smooth": 80
    },
    "lds": {
        "num_bins": 100,
        "kernel": "gaussian",
        "ks": 3,
        "sigma": 0.5
    },
    "regression_head": {
        "dims": [256, 128, 64]
    },
    "decoupled_training": {
        "enabled": true,
        "stage2_epochs": 100,
        "stage2_lr": 1e-4,
        "stage2_patience": 10,
        "fds_start_update": 0,
        "fds_start_smooth": 30
    },
    "data_collection": {
        "tle_filter": {
            "enabled": true,
            "pc_low": 1e-8,
            "pc_high": 5e-3
        }
    }
}
